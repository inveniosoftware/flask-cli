include .lgtm
include LICENSE
include MAINTAINERS AUTHORS CHANGES README.rst CONTRIBUTING.rst RELEASE-NOTES.rst
include .coveragerc run-tests.sh pytest.ini tox.ini .editorconfig
include docs/*.rst docs/*.py docs/Makefile docs/requirements.txt
include tests/*.py
include .dockerignore docker-compose.yml Dockerfile
include requirements.devel.txt
recursive-include docs/_themes *.py *.css *.css_t *.conf *.html README
recursive-include docs/_templates *.html
